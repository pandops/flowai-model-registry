{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowai.local/schemas/model-registry/defs.schema.json",
  "title": "model-registry shared definitions",
  "$defs": {
    "id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "nullableTimestamp": {
      "anyOf": [
        {
          "$ref": "#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "modelAlias": {
      "type": "string",
      "pattern": "^([1-9][0-9]{0,18}|system)/[a-z0-9][a-z0-9._-]{0,62}$"
    },
    "modelName": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,62}$"
    },
    "usd": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$"
    },
    "availability": {
      "enum": ["active", "paused", "archived", "unavailable"]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z_]+$"
        },
        "message": {
          "type": "string"
        },
        "request_id": {
          "$ref": "#/$defs/id"
        },
        "flows": {
          "$ref": "#/$defs/flowRefs"
        }
      }
    },
    "flowRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["flow_id", "name"],
        "properties": {
          "flow_id": {
            "$ref": "#/$defs/id"
          },
          "name": {
            "type": "string"
          }
        }
      }
    },
    "envelope": {
      "type": "object",
      "required": ["publisher", "publisher_seq", "occurred_at"],
      "properties": {
        "publisher": {
          "const": "model-registry"
        },
        "publisher_seq": {
          "$ref": "#/$defs/id"
        },
        "team_id": {
          "$ref": "#/$defs/id"
        },
        "occurred_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "claim": {
      "type": "object",
      "required": ["task_id", "attempt", "claim_seq"],
      "properties": {
        "task_id": {
          "$ref": "#/$defs/id"
        },
        "attempt": {
          "$ref": "#/$defs/id"
        },
        "claim_seq": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "pricing": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input_usd_per_million_tokens",
            "output_usd_per_million_tokens"
          ],
          "properties": {
            "input_usd_per_million_tokens": {
              "$ref": "#/$defs/usd"
            },
            "output_usd_per_million_tokens": {
              "$ref": "#/$defs/usd"
            }
          }
        }
      ]
    },
    "flowLimit": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "max_budget_usd": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,6})(\\.[0-9]{1,2})?$"
            },
            "budget_period": {
              "enum": ["day", "week", "month"]
            },
            "rpm": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "tpm": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000000
            }
          },
          "dependentRequired": {
            "max_budget_usd": ["budget_period"],
            "budget_period": ["max_budget_usd"]
          }
        }
      ]
    },
    "perTaskLimit": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "max_budget_usd": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,6})(\\.[0-9]{1,2})?$"
            },
            "rpm": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "tpm": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000000
            }
          }
        }
      ]
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "model_alias",
        "provider",
        "provider_model",
        "api_base",
        "credential_configured",
        "created_at",
        "updated_at",
        "model_id",
        "editable",
        "unfinished_task_count",
        "can_archive",
        "paused",
        "created_by",
        "archived_at",
        "can_unarchive",
        "archive_blocking_flows",
        "pricing",
        "pricing_status"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/modelName"
        },
        "model_alias": {
          "$ref": "#/$defs/modelAlias"
        },
        "provider": {
          "type": "string"
        },
        "provider_model": {
          "type": "string"
        },
        "api_base": {
          "type": ["string", "null"]
        },
        "credential_configured": {
          "type": "boolean"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/timestamp"
        },
        "model_id": {
          "$ref": "#/$defs/id"
        },
        "editable": {
          "type": "boolean"
        },
        "unfinished_task_count": {
          "type": "integer",
          "minimum": 0
        },
        "can_archive": {
          "type": "boolean"
        },
        "paused": {
          "type": "boolean"
        },
        "created_by": {
          "enum": ["team", "admin"]
        },
        "archived_at": {
          "$ref": "#/$defs/nullableTimestamp"
        },
        "can_unarchive": {
          "type": "boolean"
        },
        "archive_blocking_flows": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/flowRefs"
            }
          ]
        },
        "pricing": {
          "$ref": "#/$defs/pricing"
        },
        "pricing_status": {
          "enum": ["configured", "not_configured", "unsupported"]
        }
      }
    }
  }
}

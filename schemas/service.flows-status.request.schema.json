{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowai.local/schemas/model-registry/service.flows-status.request.schema.json",
  "title": "model-registry.service.flows-status request",
  "description": "Caller: flow-registry only. Header team (decimal team_id, or admin) and request_id; when team is decimal, body team_id must equal it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["body"],
  "properties": {
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": ["team_id", "flows"],
      "properties": {
        "team_id": {
          "$ref": "defs.schema.json#/$defs/id"
        },
        "flows": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["flow_id", "aliases"],
            "properties": {
              "flow_id": {
                "$ref": "defs.schema.json#/$defs/id"
              },
              "aliases": {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "type": "string",
                  "maxLength": 300
                }
              },
              "flow_limit": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "defs.schema.json#/$defs/flowLimit"
                  }
                ]
              }
            },
            "description": "flow_limit is accepted for the caller's convenience; usage budget fields come from model-registry's own Flow team mapping."
          }
        }
      }
    }
  }
}

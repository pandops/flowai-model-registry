{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowai.local/schemas/model-registry/event.task-key-issued.schema.json",
  "title": "model-registry.event.task-key-issued",
  "description": "model-registry created the LiteLLM virtual key of a claim (the key itself is never published). Subject model-registry.event.task-key-issued.pub on ALL_EVENT; headers team (decimal team_id) and Nats-Msg-Id model-registry-<publisher_seq>. Carries no provider credential, master key or virtual key.",
  "allOf": [
    {
      "$ref": "defs.schema.json#/$defs/envelope"
    }
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "publisher",
    "publisher_seq",
    "team_id",
    "occurred_at",
    "kind",
    "task_id",
    "attempt",
    "claim_seq",
    "model_alias",
    "expires_at"
  ],
  "properties": {
    "publisher": true,
    "publisher_seq": true,
    "team_id": true,
    "occurred_at": true,
    "kind": {
      "const": "task-key-issued"
    },
    "task_id": {
      "$ref": "defs.schema.json#/$defs/id"
    },
    "attempt": {
      "$ref": "defs.schema.json#/$defs/id"
    },
    "claim_seq": {
      "$ref": "defs.schema.json#/$defs/id"
    },
    "model_alias": {
      "$ref": "defs.schema.json#/$defs/modelAlias"
    },
    "expires_at": {
      "$ref": "defs.schema.json#/$defs/timestamp"
    }
  }
}
